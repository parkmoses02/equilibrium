+/* ---------- optional raw-frame stream to a laptop (display only, never blocks the control path) ---------- */
+#define STREAM_MAGIC 0x31464350u   /* bytes 'P','C','F','1' on the wire (little-endian) */
+
+typedef struct __attribute__((packed)) {
+    uint32_t magic, seq;
+    uint64_t ts_us;              /* driver frame timestamp in us (0 if unavailable) */
+    uint16_t w, h;
+    uint32_t stride, payload;    /* payload = stride * h bytes of raw UYVY follow the header */
+    uint16_t flags;              /* b0: --vflip is active; the viewer flips the image and the blobs the same way */
+    uint16_t rflags;             /* Rec.flags of the on-board tracker (b0 calibrating, b1 no pivot, b2 tip, b3 mid) */
+    float px, py, tx, ty, mx, my, ang;   /* on-board result (NaN = none); y already flipped like the UART packet */
+    float proc_ms, lat_ms;
+} StreamHdr;                     /* 68 bytes */
+
+typedef struct {
+    int lfd, cfd;                /* listening / client socket */
+    volatile int connected, stop;
+    int full;                    /* slot holds a frame that the sender thread has not finished sending (under mu) */
+    pthread_t th;
+    pthread_mutex_t mu; pthread_cond_t cv;
+    StreamHdr hdr; uint8_t *buf;
+    int div, tick;
+    unsigned long sent, skipped, copies; double copy_ms;
+} Stream;
+
+static int send_all(int fd, const void *p, size_t n) {
+    const uint8_t *b = p;
+    while (n) {
+        ssize_t k = send(fd, b, n, MSG_NOSIGNAL);
+        if (k < 0) { if (errno == EINTR) continue; return -1; }
+        if (k == 0) return -1;
+        b += k; n -= (size_t)k;
+    }
+    return 0;
+}
+
+static void *stream_thread(void *arg) {
+    Stream *s = (Stream *)arg;
+    while (!s->stop) {
+        if (s->cfd < 0) {                         /* wait for the viewer */
+            struct pollfd p = { s->lfd, POLLIN, 0 };
+            if (poll(&p, 1, 200) > 0) {
+                int fd = accept(s->lfd, NULL, NULL);
+                if (fd >= 0) {
+                    int one = 1, sb = 4 << 20;
+                    setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof one);
+                    setsockopt(fd, SOL_SOCKET, SO_SNDBUF, &sb, sizeof sb);
+                    s->cfd = fd; s->connected = 1;
+                    fprintf(stderr, "stream: viewer connected\n");
+                }
+            }
+            continue;
+        }
+        pthread_mutex_lock(&s->mu);
+        while (!s->full && !s->stop) pthread_cond_wait(&s->cv, &s->mu);
+        pthread_mutex_unlock(&s->mu);
+        if (s->stop) break;
+        if (send_all(s->cfd, &s->hdr, sizeof s->hdr) < 0 || send_all(s->cfd, s->buf, s->hdr.payload) < 0) {
+            close(s->cfd); s->cfd = -1; s->connected = 0;
+            fprintf(stderr, "stream: viewer disconnected\n");
+        } else s->sent++;
+        pthread_mutex_lock(&s->mu); s->full = 0; pthread_mutex_unlock(&s->mu);
+    }
+    return NULL;
+}
+
+static Stream *stream_open(int port, int div, size_t frame_bytes) {
+    Stream *s = calloc(1, sizeof(*s));
+    if (!s) return NULL;
+    s->cfd = -1; s->div = div < 1 ? 1 : div;
+    s->buf = malloc(frame_bytes);
+    s->lfd = socket(AF_INET, SOCK_STREAM, 0);
+    if (!s->buf || s->lfd < 0) { perror("stream socket"); return NULL; }
+    int one = 1; setsockopt(s->lfd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);
+    struct sockaddr_in a; memset(&a, 0, sizeof a);
+    a.sin_family = AF_INET; a.sin_addr.s_addr = htonl(INADDR_ANY); a.sin_port = htons((uint16_t)port);
+    if (bind(s->lfd, (struct sockaddr *)&a, sizeof a) < 0 || listen(s->lfd, 1) < 0) { perror("stream bind/listen"); return NULL; }
+    pthread_mutex_init(&s->mu, NULL); pthread_cond_init(&s->cv, NULL);
+    if (pthread_create(&s->th, NULL, stream_thread, s) != 0) { perror("stream thread"); return NULL; }
+    fprintf(stderr, "stream: listening on TCP port %d, every %d-th frame (%zu bytes each) once a viewer connects\n",
+            port, s->div, frame_bytes);
+    return s;
+}
+
+/* Called from the capture loop AFTER the UART packet went out and BEFORE the buffer is re-queued.
+ * Copies the frame only when a viewer is connected, the sender is idle and it is this frame's turn. */
+static void stream_offer(Stream *s, const uint8_t *img, int W, int H, int stride, const Rec *r,
+                         double ts_s, int vflip) {
+    if (!s || !s->connected) return;
+    if (++s->tick < s->div) return;
+    s->tick = 0;
+    pthread_mutex_lock(&s->mu); int full = s->full; pthread_mutex_unlock(&s->mu);
+    if (full) { s->skipped++; return; }
+    double t0 = now_s();
+    memcpy(s->buf, img, (size_t)stride * H);
+    StreamHdr *h = &s->hdr;
+    h->magic = STREAM_MAGIC; h->seq = r->seq; h->ts_us = ts_s > 0 ? (uint64_t)(ts_s * 1e6) : 0;
+    h->w = (uint16_t)W; h->h = (uint16_t)H; h->stride = (uint32_t)stride; h->payload = (uint32_t)((size_t)stride * H);
+    h->flags = vflip ? 1 : 0; h->rflags = (uint16_t)r->flags;
+    h->px = (float)r->px; h->py = (float)r->py; h->tx = (float)r->tx; h->ty = (float)r->ty;
+    h->mx = (float)r->mx; h->my = (float)r->my; h->ang = (float)r->ang;
+    h->proc_ms = (float)r->proc_ms; h->lat_ms = (float)r->lat_ms;
+    pthread_mutex_lock(&s->mu); s->full = 1; pthread_cond_signal(&s->cv); pthread_mutex_unlock(&s->mu);
+    s->copy_ms += (now_s() - t0) * 1e3; s->copies++;
+}
+
+static void stream_close(Stream *s) {
+    if (!s) return;
+    s->stop = 1;
+    pthread_mutex_lock(&s->mu); pthread_cond_signal(&s->cv); pthread_mutex_unlock(&s->mu);
+    if (s->cfd >= 0) shutdown(s->cfd, SHUT_RDWR);
+    pthread_join(s->th, NULL);
+    if (s->cfd >= 0) close(s->cfd);
+    close(s->lfd);
+}
